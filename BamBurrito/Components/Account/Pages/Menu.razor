@page "/menu"

<div class="min-h-screen bg-zinc-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto text-center mb-16">
        <span class="text-xs font-bold tracking-widest text-red-500 uppercase bg-red-50 px-3 py-1 rounded-full">Fräscht & Handgjort</span>
        <h1 class="mt-3 text-5xl font-extrabold text-zinc-900 tracking-tight sm:text-6xl">
            Vår Meny
        </h1>
        <p class="mt-4 text-lg text-zinc-500 max-w-xl mx-auto">
            Premium burritos rullade med kärlek direkt från foodtrucken. Hitta din favorit!
        </p>
    </div>

    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">

        <div class="bg-white rounded-[2.5rem] p-8 shadow-[0_10px_30px_rgb(0,0,0,0.04)] border border-zinc-100 flex flex-col justify-between transform transition duration-300 hover:scale-[1.02] hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)]">
            <div>
                <div class="flex justify-between items-start mb-4">
                    <h2 class="text-2xl font-bold text-zinc-900">El Clásico Burrito</h2>
                    <span class="text-xl font-extrabold text-zinc-900 bg-zinc-100 px-4 py-1 rounded-2xl">135 kr</span>
                </div>
                <p class="text-zinc-500 leading-relaxed mb-6">
                    Långkokt högrev, kryddigt mexikanskt ris, svarta bönor, pico de gallo och vår hemliga krämiga chipotle-majo.
                </p>
                <div class="flex gap-2">
                    <span class="text-xs font-semibold bg-red-50 text-red-600 px-3 py-1 rounded-xl">Populär</span>
                    <span class="text-xs font-semibold bg-orange-50 text-orange-600 px-3 py-1 rounded-xl">Lite stark</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-[2.5rem] p-8 shadow-[0_10px_30px_rgb(0,0,0,0.04)] border border-zinc-100 flex flex-col justify-between transform transition duration-300 hover:scale-[1.02] hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)]">
            <div>
                <div class="flex justify-between items-start mb-4">
                    <h2 class="text-2xl font-bold text-zinc-900">Holy Guacamole</h2>
                    <span class="text-xl font-extrabold text-zinc-900 bg-zinc-100 px-4 py-1 rounded-2xl">125 kr</span>
                </div>
                <p class="text-zinc-500 leading-relaxed mb-6">
                    Ugnsrostad sötpotatis, krispigt majs-salsa, picklad rödlök, fyllig guacamole och en frisk lime-crema.
                </p>
                <div class="flex gap-2">
                    <span class="text-xs font-semibold bg-green-50 text-green-600 px-3 py-1 rounded-xl">Veggie</span>
                    <span class="text-xs font-semibold bg-blue-50 text-blue-600 px-3 py-1 rounded-xl">Fräsch</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-[2.5rem] p-8 shadow-[0_10px_30px_rgb(0,0,0,0.04)] border border-zinc-100 flex flex-col justify-between transform transition duration-300 hover:scale-[1.02] hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)]">
            <div>
                <div class="flex justify-between items-start mb-4">
                    <h2 class="text-2xl font-bold text-zinc-900">Fuego Chicken</h2>
                    <span class="text-xl font-extrabold text-zinc-900 bg-zinc-100 px-4 py-1 rounded-2xl">130 kr</span>
                </div>
                <p class="text-zinc-500 leading-relaxed mb-6">
                    Strimlad kycklingfilé i marinad av rökt jalapeño, serveras med majs, syrad grädde och het habanerosalsa.
                </p>
                <div class="flex gap-2">
                    <span class="text-xs font-semibold bg-red-100 text-red-700 px-3 py-1 rounded-xl">Mycket stark 🔥</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-[2.5rem] p-8 shadow-[0_10px_30px_rgb(0,0,0,0.04)] border border-zinc-100 flex flex-col justify-between transform transition duration-300 hover:scale-[1.02] hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)]">
            <div>
                <div class="flex justify-between items-start mb-4">
                    <h2 class="text-2xl font-bold text-zinc-900">Loaded Nachos</h2>
                    <span class="text-xl font-extrabold text-zinc-900 bg-zinc-100 px-4 py-1 rounded-2xl">65 kr</span>
                </div>
                <p class="text-zinc-500 leading-relaxed mb-6">
                    Krispiga majstortillas som badar i smält ostsås, toppade med jalapeños och färsk koriander. Perfekt att dela!
                </p>
                <div class="flex gap-2">
                    <span class="text-xs font-semibold bg-yellow-50 text-yellow-700 px-3 py-1 rounded-xl">Tillbehör</span>
                </div>
            </div>
        </div>

    </div>
</div>