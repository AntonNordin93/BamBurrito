@page "/om-oss"
<PageTitle>Om oss - BAM! Burrito</PageTitle>

<svg style="position: absolute; width: 0; height: 0; pointer-events: none;" aria-hidden="true">
    <defs>
        <filter id="rugged-top" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="4" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" xChannelSelector="R" yChannelSelector="G" />
        </filter>

        <filter id="rugged-price" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="4" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="13" xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </defs>
</svg>

<div class="w-full min-h-screen bg-gray-900 text-white pb-32 relative overflow-hidden">

    <div class="max-w-4xl mx-auto text-center pt-16 pb-12 px-4 relative z-10">
        <span class="text-bamorange uppercase tracking-widest font-trueno text-xs block mb-2 font-bold">Lär känna oss</span>
        <h1 class="text-5xl md:text-7xl font-trueno uppercase tracking-wide drop-shadow-[0_4px_12px_rgba(0,0,0,0.9)]">
            Om <span class="text-bamorange">oss</span>
        </h1>
        <div class="w-24 h-1 bg-bamorange mx-auto mt-4 rounded-full shadow-md"></div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="relative transition-all duration-300 flex flex-col p-8 md:p-14 bg-[#0b0f19] border-2 border-gray-700 hover:border-bamorange rounded-xl shadow-lg">

            <h2 class="text-3xl font-trueno uppercase tracking-wider text-bamorange drop-shadow mb-8 border-l-4 border-bamorange pl-4">
                BAM! BURRITO
            </h2>

            <p class="font-trueno text-base text-gray-300 leading-relaxed uppercase tracking-wide mb-6">
                BAM! BURRITO startas av två bröder som vill dela med sig av sin passion för god mat. 
                Från vår matvagn kommer vi servera burritos och andra rätter inspirerade av sydamerikanska smaker, 
                enkel och god mat som passar både vardag och event.
            </p>

            <p class="font-trueno text-base text-gray-300 leading-relaxed uppercase tracking-wide">
                Vi ser fram emot att träffa människor runt om i Sundsvall samt på olika evenemang i hela Sverige 
                och hoppas kunna bli ett uppskattat inslag för den som är sugen på snabb och smakrik mat.
            </p>

            <div class="mt-12 overflow-visible pointer-events-none w-full flex justify-center">
                <svg viewBox="0 0 1000 40" preserveAspectRatio="none" class="w-full h-4 overflow-visible opacity-50">
                    <path d="M0,20 L50,15 L100,25 L150,15 L200,25 L250,15 L300,25 L350,15 L400,25 L450,15 L500,25 L550,15 L600,25 L650,15 L700,25 L750,15 L800,25 L850,15 L900,25 L950,15 L1000,20" 
                          stroke="#FF8400" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-top)" />
                </svg>
            </div>

        </div>
    </div>
</div>
