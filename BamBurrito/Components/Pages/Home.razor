@page "/"

<PageTitle>BAM! Burrito</PageTitle>

<div class="relative bg-gray-900 overflow-hidden flex-grow flex items-center justify-center min-h-[80vh]">

    <div class="absolute inset-0 z-0" id="hero-slideshow">
        <img class="absolute inset-0 w-full h-full object-cover opacity-40 transition-opacity duration-1000 slide-img" src="assets/723084232_1453083233505854_175653955387539219_n.jpg" alt="BamBurrito Truck Vy" />
        <img class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000 slide-img" src="assets/722520332_2439464333240935_6561008539144260035_n.jpg" alt="BamBurrito Truck Front" />
        <img class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000 slide-img" src="assets/722985851_1524414919141210_368542673939215696_n.jpg" alt="BamBurrito Kök" />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
        <h1 class="text-4xl md:text-7xl font-trueno text-white tracking-wider uppercase drop-shadow-lg mb-6">
            ¡Bienvenidos a <span class="text-bamorange">BAM! Burrito!</span>
        </h1>

        <p class="mt-4 text-2xl md:text-3xl text-gray-200 max-w-4xl mx-auto font-semibold drop-shadow-md mb-12">
            Klassisk foodtruck & catering - Äkta smaker fyllda med <span class="text-bamorange">kärlek</span>!
        </p>

        <div class="flex flex-col md:flex-row gap-14 md:gap-48 justify-center relative z-30">
            <a href="menu" class="inline-block text-2xl md:text-4xl font-trueno text-white hover:!text-bamorange hover:!underline transition-transform duration-300 uppercase tracking-wider transform hover:scale-110 active:scale-95">
                Unna dig en burrito!
            </a>
            <a href="kontakt" class="inline-block text-2xl md:text-4xl font-trueno text-white hover:!text-bamorange hover:!underline transition-transform duration-300 uppercase tracking-wider transform hover:scale-110 active:scale-95">
                Mer info
            </a>
        </div>
    </div>
</div>