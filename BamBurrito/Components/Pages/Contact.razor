@page "/kontakt"
@rendermode InteractiveServer
<PageTitle>Kontakt - BAM! Burrito</PageTitle>

<svg style="position: absolute; width: 0; height: 0; pointer-events: none;" aria-hidden="true">
    <defs>
        <filter id="rugged-top" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="4" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" xChannelSelector="R" yChannelSelector="G" />
        </filter>

        <filter id="rugged-price" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="4" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="13" xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </defs>
</svg>

<div class="w-full min-h-screen bg-gray-900 text-white pb-32 relative overflow-hidden">

    <div class="max-w-4xl mx-auto text-center pt-16 pb-12 px-4 relative z-10">
        <span class="text-bamorange uppercase tracking-widest font-trueno text-xs block mb-2 font-bold">Har du frågor?</span>
        <h1 class="text-5xl md:text-7xl font-trueno uppercase tracking-wide drop-shadow-[0_4px_12px_rgba(0,0,0,0.9)]">
            Kon<span class="text-bamorange">takt</span>
        </h1>
        <div class="w-24 h-1 bg-bamorange mx-auto mt-4 rounded-full shadow-md"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 mt-4">

            <!-- Catering & Event -->
            <div class="relative transition-all duration-300 flex flex-col p-8 md:p-12 bg-[#0b0f19] border-2 border-gray-700 hover:border-bamorange rounded-xl shadow-lg h-full">
                <h2 class="text-3xl font-trueno uppercase tracking-wider text-bamorange drop-shadow mb-6 border-l-4 border-bamorange pl-4">
                    Catering & Event
                </h2>

                <p class="font-trueno text-base text-gray-300 leading-relaxed uppercase tracking-wide mb-4">
                    Behöver du mat till ett event eller catering? Hör av dig!
                </p>
                <p class="font-trueno text-sm text-gray-400 leading-relaxed uppercase tracking-wide mb-4">
                    Oavsett om det är en liten tillställning eller ett större event ser vi till att maten sitter som den ska.
                    Vi lagar, levererar och serverar riktigt bra käk som passar just ditt tillfälle – utan krångel.
                </p>
                <p class="font-trueno text-sm text-gray-400 leading-relaxed uppercase tracking-wide">
                    Du slipper stressa över maten och kan fokusera på gästerna istället.
                    Hör av dig så löser vi något gott tillsammans!
                </p>

                <div class="flex-grow"></div>

                <div class="mt-8 flex justify-center w-full relative z-20">
                    <button type="button" @onclick="OpenModal" class="relative w-full md:w-3/4 h-16 flex items-center justify-center transform hover:scale-[1.02] transition-all duration-300 group cursor-pointer">
                        <div class="absolute inset-0 z-0 overflow-visible pointer-events-none">
                            <svg viewBox="0 0 400 50" preserveAspectRatio="none" class="w-full h-full overflow-visible">
                                <path d="M 4,4 L 396,6 L 394,46 L 6,44 Z" fill="#FF8400" filter="url(#rugged-price)" class="group-hover:fill-yellow-400 transition-colors duration-300" />
                            </svg>
                        </div>
                        <span class="relative z-10 font-trueno text-xl text-[#0b0f19] font-black uppercase tracking-widest pt-1 drop-shadow-sm">
                            Offertförfrågan
                        </span>
                    </button>
                </div>

                <div class="mt-8 overflow-visible pointer-events-none w-full flex justify-center z-10">
                    <svg viewBox="0 0 1000 40" preserveAspectRatio="none" class="w-full h-4 overflow-visible opacity-50">
                        <path d="M0,20 L50,15 L100,25 L150,15 L200,25 L250,15 L300,25 L350,15 L400,25 L450,15 L500,25 L550,15 L600,25 L650,15 L700,25 L750,15 L800,25 L850,15 L900,25 L950,15 L1000,20"
                              stroke="#FF8400" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-top)" />
                    </svg>
                </div>
            </div>

            <!-- Följ oss & Kontakt info -->
            <div class="relative transition-all duration-300 flex flex-col p-8 md:p-12 bg-[#0b0f19] border-2 border-gray-700 hover:border-bamorange rounded-xl shadow-lg h-full">

                <h2 class="text-3xl font-trueno uppercase tracking-wider text-white drop-shadow mb-8">
                    Följ oss <span class="text-bamorange">här!</span>
                </h2>

                <div class="mb-8">
                    <h3 class="text-xl font-trueno uppercase tracking-widest text-bamorange mb-3">Öppettider</h3>
                    <p class="font-trueno text-sm text-gray-400 leading-relaxed uppercase tracking-wide mb-4">
                        Följ oss på sociala medier för att se våra öppettider, eller klicka in på <a href="/places" class="text-white hover:text-bamorange underline transition-colors">Platser</a> för att se vecka för vecka.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4 mt-2">
                        <a href="https://www.facebook.com/profile.php?id=61588663281337" target="_blank" class="flex items-center gap-2 group w-fit transition-all duration-300">
                            <svg class="h-8 w-8 text-bamorange transform transition duration-300 group-hover:scale-110 group-hover:-rotate-6 group-hover:text-yellow-400 drop-shadow-md" fill="currentColor" viewBox="0 0 24 24">
                                <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
                            </svg>
                            <span class="font-trueno text-sm uppercase tracking-widest text-gray-300 group-hover:text-yellow-400 transition-colors duration-300">Facebook</span>
                        </a>

                        <a href="http://instagram.se/elbamburrito" target="_blank" class="flex items-center gap-2 group w-fit transition-all duration-300">
                            <svg class="h-8 w-8 text-bamorange transform transition duration-300 group-hover:scale-110 group-hover:rotate-6 group-hover:text-yellow-400 drop-shadow-md" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                            </svg>
                            <span class="font-trueno text-sm uppercase tracking-widest text-gray-300 group-hover:text-yellow-400 transition-colors duration-300">Instagram</span>
                        </a>
                    </div>
                </div>

                <div>
                    <h3 class="text-xl font-trueno uppercase tracking-widest text-bamorange mb-3">Kontakt</h3>
                    <p class="font-trueno text-lg text-white font-bold leading-relaxed tracking-wider mb-4 border-l-2 border-gray-600 pl-3">
                        Telefon - 0722017063
                    </p>
                    <p class="font-trueno text-sm text-gray-400 leading-relaxed uppercase tracking-wide mb-2">
                        Vill du boka vagnen eller bara ställa en fråga?
                    </p>
                    <p class="font-trueno text-sm text-gray-400 leading-relaxed uppercase tracking-wide">
                        Skicka ett DM på våra sociala medier så svarar vi så snart vi kan.
                    </p>
                </div>

                <div class="flex-grow"></div>

                <div class="mt-8 overflow-visible pointer-events-none w-full flex justify-center">
                    <svg viewBox="0 0 1000 40" preserveAspectRatio="none" class="w-full h-4 overflow-visible opacity-50">
                        <path d="M0,20 L50,15 L100,25 L150,15 L200,25 L250,15 L300,25 L350,15 L400,25 L450,15 L500,25 L550,15 L600,25 L650,15 L700,25 L750,15 L800,25 L850,15 L900,25 L950,15 L1000,20"
                              stroke="#FF8400" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-top)" />
                    </svg>
                </div>
            </div>

        </div>
    </div>
</div>

@if (isModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm transition-opacity duration-300">
        <div class="relative w-full max-w-lg lg:max-w-3xl bg-[#0b0f19] border-2 border-bamorange rounded-xl shadow-lg p-8 md:p-12 max-h-[90vh] overflow-y-auto w-[calc(100%-2rem)]">

            <button @onclick="CloseModal" class="absolute top-4 right-4 lg:top-6 lg:right-6 text-gray-400 hover:text-white transition-colors cursor-pointer">
                <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <h2 class="text-3xl font-trueno uppercase tracking-wider text-white drop-shadow mb-2 leading-tight">
                <span class="block sm:inline">Offert</span><span class="text-bamorange block sm:inline">förfrågan</span>
            </h2>
            <div class="w-16 h-1 bg-bamorange mb-8 rounded-full"></div>

            <EditForm Model="offerRequest" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if (showError)
                {
                    <div class="mb-6 border-l-4 border-red-500 bg-red-900/20 p-4 text-sm font-trueno tracking-widest text-red-400 uppercase">
                        Kunde inte skicka förfrågan. Vänligen försök igen eller kontakta oss manuellt.
                    </div>
                }

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">

                    <div class="w-full">
                        <label class="font-trueno text-[10px] lg:text-xs text-gray-400 mb-1 lg:mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Ditt Namn/Företag *</label>
                        <InputText @bind-Value="offerRequest.Name" placeholder="T.ex. Ica Alnö" class="font-trueno text-xs lg:text-sm uppercase w-full p-2 lg:p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white rounded" />
                        <ValidationMessage For="@(() => offerRequest.Name)" class="text-red-500 font-trueno text-[10px] uppercase mt-1 tracking-widest" />
                    </div>

                    <div class="w-full">
                        <label class="font-trueno text-[10px] lg:text-xs text-gray-400 mb-1 lg:mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Din Email *</label>
                        <InputText @bind-Value="offerRequest.Email" placeholder="namn@foretag.se" class="font-trueno text-xs lg:text-sm uppercase w-full p-2 lg:p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white rounded cursor-text" />
                        <ValidationMessage For="@(() => offerRequest.Email)" class="text-red-500 font-trueno text-[10px] uppercase mt-1 tracking-widest" />
                    </div>

                    <div class="md:col-span-2 w-full mt-1 lg:mt-2">
                        <label class="font-trueno text-[10px] lg:text-xs text-gray-400 mb-1 lg:mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Adress *</label>
                        <InputText @bind-Value="offerRequest.Address" placeholder="Företagsvägen 1, 852 30 Sundsvall" class="font-trueno text-xs lg:text-sm uppercase w-full p-2 lg:p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white rounded cursor-text" />
                        <ValidationMessage For="@(() => offerRequest.Address)" class="text-red-500 font-trueno text-[10px] uppercase mt-1 tracking-widest" />
                    </div>

                    <div class="md:col-span-2 w-full pt-3 lg:pt-4 border-t border-gray-800 mt-1 lg:mt-2">
                        <label class="font-trueno text-[10px] lg:text-xs text-gray-400 mb-1 lg:mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Önskat Datum *</label>
                        <InputDate Type="InputDateType.Date" @bind-Value="offerRequest.Date" class="bam-date-picker font-trueno text-xs lg:text-sm w-full p-2 lg:p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white uppercase tracking-wider rounded" />
                    </div>

                    <div class="w-full">
                        <label class="font-trueno text-[10px] lg:text-xs text-gray-400 mb-1 lg:mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Från klockan *</label>
                        <InputDate Type="InputDateType.Time" @bind-Value="offerRequest.StartTime" class="bam-date-picker font-trueno text-xs lg:text-sm w-full p-2 lg:p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white uppercase tracking-wider rounded" />
                    </div>

                    <div class="w-full">
                        <label class="font-trueno text-[10px] lg:text-xs text-gray-400 mb-1 lg:mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Till klockan *</label>
                        <InputDate Type="InputDateType.Time" @bind-Value="offerRequest.EndTime" class="bam-date-picker font-trueno text-xs lg:text-sm w-full p-2 lg:p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white uppercase tracking-wider rounded" />
                    </div>

                    <div class="md:col-span-2 w-full mt-1 lg:mt-2">
                        <label class="font-trueno text-[10px] lg:text-xs text-gray-400 mb-1 lg:mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Berätta mer om eventet *</label>
                        <InputTextArea @bind-Value="offerRequest.Message" placeholder="Antal personer, typ av tillställning etc..." class="font-trueno text-xs lg:text-sm uppercase w-full p-2 lg:p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white h-24 sm:h-32 lg:h-32 resize-none rounded leading-relaxed cursor-text" />
                        <ValidationMessage For="@(() => offerRequest.Message)" class="text-red-500 font-trueno text-[10px] uppercase mt-1 tracking-widest" />
                    </div>
                </div>

                <button type="submit" disabled="@isSubmitting" class="relative w-full h-12 lg:h-16 mt-6 lg:mt-8 flex items-center justify-center transform hover:scale-[1.02] transition-all duration-300 group cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100">
                    <div class="absolute inset-0 z-0 overflow-visible pointer-events-none">
                        <svg viewBox="0 0 400 50" preserveAspectRatio="none" class="w-full h-full overflow-visible">
                            <path d="M 4,4 L 396,6 L 394,46 L 6,44 Z" fill="#FF8400" filter="url(#rugged-price)" class="group-hover:fill-yellow-400 transition-colors duration-300" />
                        </svg>
                    </div>
                    <span class="relative z-10 font-trueno text-xl text-[#0b0f19] font-black uppercase tracking-widest pt-1 drop-shadow-sm">
                        @(isSubmitting ? "Skickar..." : "Skicka Förfrågan!")
                    </span>
                </button>
            </EditForm>
        </div>
    </div>
}

@if (isSuccessModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm transition-opacity duration-300">
        <div class="relative w-full max-w-lg bg-[#0b0f19] border-2 border-green-500 rounded-xl shadow-2xl p-10 text-center">

            <div class="mx-auto w-24 h-24 bg-green-500/20 rounded-full flex items-center justify-center mb-6">
                <svg class="h-12 w-12 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>

            <h2 class="text-3xl font-trueno uppercase tracking-wider text-white drop-shadow mb-4">
                Förfrågan <span class="text-green-500">Skickad!</span>
            </h2>

            <p class="font-trueno text-sm text-gray-400 leading-relaxed uppercase tracking-wide mb-8">
                Tack för ditt meddelande! Vi har mottagit din förfrågan och återkommer med en offert så snart vi kan.
            </p>

            <button @onclick="CloseSuccessModal" class="inline-block px-8 py-3 bg-[#1f2937] hover:bg-gray-700 text-white font-trueno text-sm uppercase tracking-widest rounded transition-colors cursor-pointer border border-gray-600 outline-none">
                Stäng
            </button>
        </div>
    </div>
}
