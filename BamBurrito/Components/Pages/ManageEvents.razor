@page "/hemlig-admin-sida-2026"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using BamBurrito.Core.Entities
@attribute [Authorize(Roles = "Admin")]

<style>
    .bam-date-picker {
        color-scheme: dark;
    }

        .bam-date-picker::-webkit-calendar-picker-indicator {
            cursor: pointer;
            padding: 5px;
            filter: invert(0.8);
        }

    .valid.modified:not([type=checkbox]), .invalid.modified:not([type=checkbox]) {
        outline: none !important;
    }
</style>

<svg style="position: absolute; width: 0; height: 0; pointer-events: none;" aria-hidden="true">
    <defs>
        <filter id="rugged-top" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="4" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" xChannelSelector="R" yChannelSelector="G" />
        </filter>

        <filter id="rugged-price" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="4" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="13" xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </defs>
</svg>

@if (!isAuthorized)
{
    <div class="min-h-screen bg-gray-900 flex items-center justify-center p-10 text-white font-trueno uppercase tracking-widest text-2xl">
        Verifierar åtkomst...
    </div>
}
else
{
    <div class="w-full min-h-screen bg-gray-900 text-white pb-32 relative overflow-hidden">

        <div class="max-w-4xl mx-auto text-center pt-16 pb-12 px-4 relative z-10">
            <span class="text-bamorange uppercase tracking-widest font-trueno text-xs block mb-2 font-bold">Admin-Zonen</span>
            <h1 class="text-5xl md:text-6xl font-trueno uppercase tracking-wide drop-shadow-[0_4px_12px_rgba(0,0,0,0.9)]">
                @(newEvent?.Id == 0 ? "Ny " : "Redigera ") <span class="text-bamorange">Plats</span>
            </h1>
            <div class="w-24 h-1 bg-bamorange mx-auto mt-4 rounded-full shadow-md"></div>
        </div>

        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 mt-6">

            <div class="relative group transition-all duration-300 px-6 py-12 md:p-16 mb-24 min-h-[300px]">

                <div class="absolute -left-2 -right-2 -top-10 -bottom-12 md:-inset-6 z-0 overflow-visible pointer-events-none">
                    <svg viewBox="0 0 300 200" preserveAspectRatio="none" class="w-full h-full overflow-visible">
                        <path d="M 14,12 L 80,9 L 160,13 L 230,10 L 288,14 L 292,50 L 287,100 L 291,150 L 286,188 L 220,192 L 150,185 L 80,191 L 12,186 L 8,140 L 13,90 L 9,45 Z"
                              fill="#0b0f19" filter="url(#rugged-top)" class="shadow-2xl" />
                        <path d="M 14,12 L 80,9 L 160,13 L 230,10 L 288,14 L 292,50 L 287,100 L 291,150 L 286,188 L 220,192 L 150,185 L 80,191 L 12,186 L 8,140 L 13,90 L 9,45 Z"
                              fill="none" stroke="#FF8400" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-top)" />
                    </svg>
                </div>

                <div class="relative z-10">
                    @if (newEvent != null)
                    {
                        <EditForm Model="newEvent" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-red-500 font-trueno text-sm mb-4 border-l-4 border-red-500 pl-4 bg-red-900/20 p-2" />

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 md:gap-y-10">

                                <div class="w-full relative z-20">
                                    <label class="font-trueno text-xs text-gray-400 mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Platsnamn *</label>
                                    <InputText @bind-Value="newEvent.Title" placeholder="T.ex. Ica Alnö" class="font-trueno text-sm uppercase w-full p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner relative z-20" />
                                </div>
                                <div class="w-full relative z-20">
                                    <label class="font-trueno text-xs text-gray-400 mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Adress *</label>
                                    <InputText @bind-Value="newEvent.Address" placeholder="T.ex. Raholmsvägen 1" class="font-trueno text-sm uppercase w-full p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner relative z-20" />
                                </div>

                                <div class="w-full relative z-20">
                                    <label class="font-trueno text-xs text-gray-400 mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Från</label>
                                    <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="newEvent.StartTime" class="bam-date-picker font-trueno text-sm w-full p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white uppercase tracking-wider relative z-20" />
                                </div>
                                <div class="w-full relative z-20">
                                    <label class="font-trueno text-xs text-gray-400 mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Till</label>
                                    <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="newEvent.EndTime" class="bam-date-picker font-trueno text-sm w-full p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white uppercase tracking-wider relative z-20" />
                                </div>

                                @if (newEvent.Id == 0)
                                {
                                    <div class="md:col-span-2 w-full relative z-20 flex justify-start mt-2">
                                        <button type="button" @onclick="AddDate" class="text-xs font-trueno font-bold uppercase tracking-widest bg-[#0b0f19] border border-bamorange text-white px-4 py-3 hover:bg-bamorange hover:text-[#0b0f19] transition-colors rounded shadow-md cursor-pointer">
                                            + Lägg till datum
                                        </button>
                                    </div>

                                    @for (int i = 0; i < additionalDates.Count; i++)
                                    {
                                        var index = i;
                                        var date = additionalDates[index];
                                        <div class="w-full relative z-20">
                                            <div class="flex justify-between items-end mb-2">
                                                <label class="font-trueno text-xs text-gray-400 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Extra Från</label>
                                            </div>
                                            <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="date.StartTime" class="bam-date-picker font-trueno text-sm w-full p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white uppercase tracking-wider relative z-20" />
                                        </div>
                                        <div class="w-full relative z-20">
                                            <div class="flex justify-between items-end mb-2">
                                                <label class="font-trueno text-xs text-gray-400 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Extra Till</label>
                                                <button type="button" @onclick="() => RemoveDate(date)" class="text-[10px] uppercase text-red-500 hover:text-red-300 font-trueno cursor-pointer">Ta bort</button>
                                            </div>
                                            <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="date.EndTime" class="bam-date-picker font-trueno text-sm w-full p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white uppercase tracking-wider relative z-20" />
                                        </div>
                                    }
                                }

                                <div class="md:col-span-2 w-full relative z-20">
                                    <label class="font-trueno text-xs text-gray-400 mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Beskrivning</label>
                                    <InputTextArea @bind-Value="newEvent.Description" placeholder="Övrig information om eventet..." class="font-trueno text-sm uppercase w-full p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner h-28 resize-none leading-relaxed relative z-20" />
                                </div>

                                <div class="md:col-span-2 w-full relative z-20 mt-2">
                                    <label class="font-trueno text-xs text-gray-400 mb-2 block uppercase tracking-widest border-l-2 border-bamorange pl-2">Bakgrundsbild</label>
                                    <InputFile OnChange="HandleFileSelected" accept="image/*" class="font-trueno text-sm w-full p-4 bg-gray-900 border-none focus:ring-2 focus:ring-bamorange outline-none shadow-inner text-white file:mr-4 file:py-2 file:px-4 file:border-0 file:text-sm file:font-semibold file:bg-bamorange file:text-[#0b0f19] hover:file:bg-yellow-400 file:cursor-pointer relative z-20" />
                                    @if (!string.IsNullOrEmpty(newEvent.ImagePath))
                                    {
                                        <div class="mt-4 text-xs text-gray-400 flex flex-col gap-2">
                                            <span class="uppercase tracking-widest ml-1">Nuvarande bild:</span>
                                            <img src="@newEvent.ImagePath" alt="Bakgrundsbild" class="max-h-32 w-auto rounded border border-gray-700 shadow-md object-cover" />
                                        </div>
                                    }
                                </div>
                            </div>

                            <button type="submit" class="relative w-full h-16 mt-10 md:mt-12 flex items-center justify-center transform hover:scale-[1.02] transition-all duration-300 group cursor-pointer z-20">
                                <div class="absolute inset-0 z-0 overflow-visible pointer-events-none">
                                    <svg viewBox="0 0 400 50" preserveAspectRatio="none" class="w-full h-full overflow-visible">
                                        <path d="M 4,4 L 396,6 L 394,46 L 6,44 Z" fill="#FF8400" filter="url(#rugged-price)" class="group-hover:fill-yellow-400 transition-colors duration-300" />
                                    </svg>
                                </div>
                                <span class="relative z-10 font-trueno text-xl text-[#0b0f19] font-black uppercase tracking-widest pt-1">
                                    ¡Spara Plats!
                                </span>
                            </button>
                        </EditForm>
                    }
                </div>
            </div>

            <div class="flex items-center gap-4 mb-8 md:mb-12 select-none">
                <h2 class="text-2xl md:text-3xl font-trueno uppercase tracking-wider text-white drop-shadow whitespace-nowrap">
                    Kommande platser
                </h2>
                <div class="flex-grow overflow-visible pointer-events-none mt-1">
                    <svg viewBox="0 0 1000 40" preserveAspectRatio="none" class="hidden md:block w-full h-8 overflow-visible">
                        <path d="M0,20 L25,10 L50,30 L75,10 L100,30 L125,10 L150,30 L175,10 L200,30 L225,10 L250,30 L275,10 L300,30 L325,10 L350,30 L375,10 L400,30 L425,10 L450,30 L475,10 L500,30 L525,10 L550,30 L575,10 L600,30 L625,10 L650,30 L675,10 L700,30 L725,10 L750,30 L775,10 L800,30 L825,10 L850,30 L875,10 L900,30 L925,10 L950,30 L975,10 L1000,20"
                              stroke="#FF8400" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-top)" />
                    </svg>
                    <svg viewBox="0 0 1000 40" preserveAspectRatio="none" class="block md:hidden w-full h-6 overflow-visible">
                        <path d="M0,20 L50,15 L100,25 L150,15 L200,25 L250,15 L300,25 L350,15 L400,25 L450,15 L500,25 L550,15 L600,25 L650,15 L700,25 L750,15 L800,25 L850,15 L900,25 L950,15 L1000,20"
                              stroke="#FF8400" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-top)" />
                    </svg>
                </div>
            </div>

            <div class="space-y-12 md:space-y-8">
                @foreach (var ev in events.OrderBy(e => e.StartTime))
                {
                    <div class="relative group transition-all duration-300 flex flex-col md:flex-row px-6 py-10 md:p-10 justify-between items-center hover:-translate-y-1 gap-6 md:gap-0">

                        <div class="absolute -left-2 -right-2 -top-8 -bottom-8 md:-inset-4 z-0 overflow-visible pointer-events-none">
                            <svg viewBox="0 0 800 120" preserveAspectRatio="none" class="w-full h-full overflow-visible">
                                <path d="M 6,5 L 795,7 L 794,115 L 4,113 Z" fill="#0b0f19" filter="url(#rugged-top)" class="shadow-lg" />
                                <path d="M 6,5 L 795,7 L 794,115 L 4,113 Z" fill="none" stroke="#374151" stroke-width="2" filter="url(#rugged-top)" class="group-hover:stroke-gray-500 transition-colors duration-300" />
                            </svg>
                        </div>

                        <div class="relative z-10 w-full md:w-auto text-left">
                            <span class="text-bamorange font-mono block mb-2 font-bold tracking-widest text-sm">
                                @ev.StartTime.ToString("yyyy-MM-dd") <span class="text-gray-500 mx-1">|</span> @ev.StartTime.ToString("HH:mm") - @ev.EndTime.ToString("HH:mm")
                            </span>
                            <h3 class="font-trueno text-2xl text-white uppercase tracking-wide mb-2">@ev.Title</h3>
                            <span class="font-trueno text-xs text-gray-400 uppercase tracking-widest border-l-2 border-gray-600 pl-2">
                                @ev.Address
                            </span>
                        </div>

                        <div class="relative z-10 flex flex-row gap-4 w-full md:w-auto mt-2 md:mt-0">
                            <button type="button" @onclick="() => EditEvent(ev)" class="relative flex-1 md:w-[130px] h-12 flex items-center justify-center transform -rotate-2 hover:rotate-0 transition-all duration-300 group cursor-pointer">
                                <div class="absolute inset-0 z-0 overflow-visible pointer-events-none">
                                    <svg viewBox="0 0 120 50" preserveAspectRatio="none" class="w-full h-full overflow-visible">
                                        <path d="M 4,6 L 116,4 L 114,46 L 6,44 Z" fill="#3b82f6" filter="url(#rugged-price)" class="group-hover:fill-blue-400 transition-colors duration-300" />
                                    </svg>
                                </div>
                                <span class="relative z-10 font-trueno text-sm text-[#0b0f19] font-black uppercase tracking-widest pt-1">
                                    Ändra
                                </span>
                            </button>

                            <button type="button" @onclick="() => DeleteEvent(ev.Id)" class="relative flex-1 md:w-[130px] h-12 flex items-center justify-center transform rotate-2 hover:rotate-0 transition-all duration-300 group cursor-pointer">
                                <div class="absolute inset-0 z-0 overflow-visible pointer-events-none">
                                    <svg viewBox="0 0 120 50" preserveAspectRatio="none" class="w-full h-full overflow-visible">
                                        <path d="M 6,4 L 114,7 L 117,45 L 3,46 Z" fill="#ef4444" filter="url(#rugged-price)" class="group-hover:fill-red-400 transition-colors duration-300" />
                                    </svg>
                                </div>
                                <span class="relative z-10 font-trueno text-sm text-[#0b0f19] font-black uppercase tracking-widest pt-1">
                                    Radera
                                </span>
                            </button>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
}