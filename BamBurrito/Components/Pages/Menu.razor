@page "/menu"

<PageTitle>Menu - BAM! Burrito</PageTitle>

<div class="w-full min-h-screen bg-gray-50 pb-24">

    <!-- Header -->
    <div class="bg-gray-900 text-white py-16 text-center relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#FF8400_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="relative z-10 max-w-4xl mx-auto px-4">
            <span class="text-bamorange uppercase tracking-widest font-trueno text-sm block mb-2">Äkta Mexikanska Smaker</span>
            <h1 class="text-5xl md:text-7xl font-trueno uppercase tracking-wide drop-shadow-md">
                Vår <span class="text-bamorange">Meny</span>
            </h1>
            <p class="mt-4 text-gray-400 font-medium max-w-lg mx-auto text-sm md:text-base">
                Alltid lagat från grunden med färska ingredienser, serverat direkt från trucken. Rullat och klart!
            </p>
        </div>
    </div>

    <!-- Meny-Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">

        @foreach (var categoryGroup in AllMenuItems.Where(item => item.IsAvailable).GroupBy(item => item.Category))
        {
            <div class="mb-20">
                <!-- Kategori-Rubrik -->
                <div class="flex items-center gap-4 mb-8">
                    <h2 class="text-3xl font-trueno uppercase tracking-wider text-gray-900">@categoryGroup.Key</h2>
                    <div class="h-[2px] bg-bamorange flex-grow rounded-full opacity-30"></div>
                </div>

                <!-- Maträtter -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    @foreach (var item in categoryGroup)
                    {
                        <div class="bg-white rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col justify-between group">
                            <div class="p-6 md:p-8">
                                <div class="flex justify-between items-start gap-4 mb-4">
                                    <h3 class="text-2xl font-trueno text-gray-900 uppercase tracking-wide group-hover:text-bamorange transition-colors">
                                        @item.Name
                                    </h3>
                                    <span class="bg-gray-900 text-white font-trueno text-lg px-4 py-1 rounded-2xl shrink-0 shadow-sm">
                                        @string.Format("{0:0}", item.Price):-
                                    </span>
                                </div>
                                <p class="text-gray-600 text-sm font-medium leading-relaxed">
                                    @item.Description
                                </p>
                            </div>
                            <div class="h-2 w-full bg-gray-900 group-hover:bg-bamorange transition-colors duration-300"></div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>