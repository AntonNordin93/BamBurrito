<footer class="bg-bamorange text-slate-900 py-2 mt-auto w-full relative">

    <div class="absolute top-0 left-0 w-full translate-y-[-100%] -mt-1 pointer-events-none z-10 overflow-visible h-8 select-none">
        <svg viewBox="0 0 1000 40" preserveAspectRatio="none" class="w-full h-full overflow-visible">
            <defs>
                <filter id="rugged-footer">
                    <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="4" result="noise" />
                    <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
                </filter>
            </defs>
            <path d="M-20,60 V20 L40,11 L80,26 L125,9 L170,24 L215,12 L260,27 L305,10 L350,25 L400,12 L450,28 L500,11 L550,26 L600,13 L650,27 L700,10 L750,25 L800,12 L850,28 L900,11 L950,26 L1020,16 V60 Z"
                  fill="#FF8400" filter="url(#rugged-footer)" />
            <path d="M-20,20 L40,11 L80,26 L125,9 L170,24 L215,12 L260,27 L305,10 L350,25 L400,12 L450,28 L500,11 L550,26 L600,13 L650,27 L700,10 L750,25 L800,12 L850,28 L900,11 L950,26 L1020,16"
                  stroke="white" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-footer)" />
        </svg>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 pt-1">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center items-center">

            <div class="flex flex-col items-center justify-center w-full">
                <img src="assets/Logo.png" alt="BamBurrito Logo" class="h-10 md:h-11 w-auto mb-1 block mx-auto" style="filter: brightness(0) saturate(100%) invert(8%) sepia(15%) saturate(3000%) hue-rotate(195deg);" />
                <p class="text-xs font-trueno leading-relaxed text-slate-900 max-w-xs text-center">
                    Foodtruck & Catering levererar grym mexikansk streetfood. Rullat och klart för dig.
                </p>
            </div>

            <div class="flex flex-col items-center">
                <h3 class="text-slate-900 text-lg font-trueno uppercase mb-1 tracking-wider">Följ oss</h3>
                <div class="flex space-x-6">
                    <a href="https://www.facebook.com/profile.php?id=61588663281337" target="_blank" class="text-slate-900 hover:scale-110 transform transition duration-200">
                        <span class="sr-only">Facebook</span>
                        <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
                            <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
                        </svg>
                    </a>
                    <a href="http://instagram.se/elbamburrito" target="_blank" class="text-slate-900 hover:scale-110 transform transition duration-200">
                        <span class="sr-only">Instagram</span>
                        <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                        </svg>
                    </a>
                </div>
            </div>

            <div class="md:text-right text-xs">
                <h3 class="text-slate-900 text-lg font-trueno uppercase mb-1 tracking-wider">Hitta Oss</h3>
                <p class="font-semibold"><a href="kontakt" class="hover:underline text-slate-900">Kontakta oss</a></p>
                <p class="font-semibold mb-1"><a href="menu" class="hover:underline text-slate-900">Se vår menu</a></p>
                <p class="text-[10px] font-bold text-slate-900">&copy; @DateTime.Now.Year Bam! Burrito.</p>
            </div>

        </div>
    </div>
</footer>