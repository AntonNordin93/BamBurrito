@using Microsoft.AspNetCore.Components.Routing

<NavLink class="flex items-center px-4 py-2 text-2xl md:text-3xl font-bangers text-black uppercase cursor-pointer transform transition-transform duration-300 ease-in-out hover:scale-110 drop-shadow-sm" href="@Href" Match="@Match" @onclick="OnClick">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <span class="@Icon mr-2" aria-hidden="true"></span>
    }
    @ChildContent
</NavLink>

@code {
    [Parameter]
    public string Href { get; set; } = string.Empty;

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }
}