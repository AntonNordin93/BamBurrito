@using Microsoft.AspNetCore.Components.Routing

<NavLink class="nav-link-item flex items-center px-4 py-1 text-2xl md:text-3xl font-trueno text-slate-900 uppercase cursor-pointer transform transition-all duration-300 ease-in-out hover:scale-110 hover:!underline drop-shadow-sm"
         href="@Href"
         Match="@Match"
         @onclick="OnClick">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <span class="@Icon mr-2" aria-hidden="true"></span>
    }
    @ChildContent
</NavLink>