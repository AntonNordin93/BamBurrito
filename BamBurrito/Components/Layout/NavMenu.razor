@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="bg-[#FF8400] shadow-[0_4px_15px_-3px_rgba(0,0,0,0.5)] w-full z-50 top-0 sticky">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-24 relative">

            <!-- Logo Section (Left) -->
            <div class="absolute left-4 md:left-0 flex-shrink-0 flex items-center">
                <a href="" class="flex items-center gap-2 transform transition hover:scale-105 duration-300">
                    <img src="assets/Logo.png" alt="BamBurrito Logo" class="h-16 md:h-20 w-auto filter drop-shadow-md" />
                </a>
            </div>

            <!-- Main Navigation Links (Centered Desktop) -->
            <div class="hidden md:flex w-full justify-center items-center space-x-4">
                <NavItem Href="meny">Meny</NavItem>
                <img src="assets/burrito.png" alt="Burrito icon" class="h-8 w-auto filter drop-shadow-md mx-2 opacity-80" />

                <NavItem Href="platser">Platser</NavItem>
                <img src="assets/burrito.png" alt="Burrito icon" class="h-8 w-auto filter drop-shadow-md mx-2 opacity-80" />

                <NavItem Href="kontakt">Kontakt</NavItem>
                <img src="assets/burrito.png" alt="Burrito icon" class="h-8 w-auto filter drop-shadow-md mx-2 opacity-80" />

                <NavItem Href="om-oss">Om Oss</NavItem>
            </div>

            <!-- Hamburger Button (Mobile) -->
            <div class="absolute right-4 md:right-0 flex items-center">
                <button type="button" @onclick="ToggleNavMenu" class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-black hover:scale-110 transform transition-transform focus:outline-none">
                    <span class="sr-only">Öppna meny</span>
                    @if (collapseNavMenu)
                    {
                        <!-- Icon when menu is closed -->
                        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    }
                    else
                    {
                        <!-- Icon when menu is open -->
                        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    }
                </button>
            </div>

        </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <div class="@NavMenuCssClass md:hidden bg-[#FF8400] border-t border-black/10 absolute w-full shadow-lg">
        <div class="px-2 pt-4 pb-6 space-y-4 sm:px-3 text-center flex flex-col items-center">
            <NavItem Href="meny" OnClick="ToggleNavMenu">Meny</NavItem>
            <img src="assets/burrito.png" alt="Burrito icon" class="h-8 w-auto filter drop-shadow-md mx-2 opacity-80" />

            <NavItem Href="platser" OnClick="ToggleNavMenu">Platser</NavItem>
            <img src="assets/burrito.png" alt="Burrito icon" class="h-8 w-auto filter drop-shadow-md mx-2 opacity-80" />

            <NavItem Href="kontakt" OnClick="ToggleNavMenu">Kontakt</NavItem>
            <img src="assets/burrito.png" alt="Burrito icon" class="h-8 w-auto filter drop-shadow-md mx-2 opacity-80" />

            <NavItem Href="om-oss" OnClick="ToggleNavMenu">Om Oss</NavItem>
        </div>
    </div>
</nav>

@code {
    private string? currentUrl;
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "hidden" : "block";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

