@rendermode InteractiveServer

<nav class="bg-[#FF8400] shadow-[0_4px_15px_-3px_rgba(0,0,0,0.5)] w-full z-50 top-0 sticky relative h-24">
    <div class="w-full max-w-[1600px] px-4 sm:px-8 lg:px-12 mx-auto h-full relative z-20">
        <div class="flex justify-between items-center h-full relative">

            <!-- Logo -->
            <div class="flex-shrink-0 flex items-center pl-2 md:pl-4">
                <a href="" class="flex items-center gap-2 transform transition hover:scale-105 duration-300">
                    <img src="assets/Logo.png" alt="BamBurrito Logo" class="h-16 md:h-20 w-auto filter drop-shadow-md" />
                </a>
            </div>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex flex-grow justify-center items-center space-x-2">
                <NavItem Href="menu">Meny</NavItem>
                <img src="assets/burrito.png" alt="Burrito icon" class="nav-burrito-icon h-10 w-10 object-contain filter drop-shadow-md opacity-80" />

                <NavItem Href="platser">Platser</NavItem>
                <img src="assets/lime.png" alt="Lime icon" class="nav-burrito-icon h-20 w-20 object-contain filter drop-shadow-md opacity-80" />

                <NavItem Href="kontakt">Kontakt</NavItem>
                <img src="assets/sombrero.png" alt="Sombrero icon" class="nav-burrito-icon h-20 w-24 object-contain filter drop-shadow-md opacity-80" />

                <NavItem Href="om-oss">Om Oss</NavItem>
                <img src="assets/chili.png" alt="Chili icon" class="nav-burrito-icon h-16 w-16 object-contain filter drop-shadow-md opacity-80" />
            </div>

            <!-- Social Media Icons -->
            <div class="hidden md:flex absolute right-0 flex-col items-center justify-center space-y-2 h-full z-20">
                <a href="https://www.facebook.com/profile.php?id=61588663281337" target="_blank" class="text-white hover:scale-110 transform transition-all duration-300 ease-in-out filter drop-shadow-sm">
                    <span class="sr-only">Facebook</span>
                    <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" /></svg>
                </a>
                <a href="http://instagram.se/elbamburrito" target="_blank" class="text-white hover:scale-110 transform transition-all duration-300 ease-in-out filter drop-shadow-sm">
                    <span class="sr-only">Instagram</span>
                    <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" /></svg>
                </a>
            </div>

            <!-- Mobile Hamburger Button -->
            <div class="absolute right-0 flex items-center md:hidden z-30">
                <button type="button" @onclick="ToggleNavMenu" class="inline-flex items-center justify-center p-3 rounded-md text-white hover:scale-110 transform transition-transform focus:outline-none relative z-50">
                    <span class="sr-only">Öppna meny</span>
                    @if (collapseNavMenu)
                    {
                        <svg class="h-10 w-10 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
                    }
                    else
                    {
                        <svg class="h-10 w-10 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
                    }
                </button>
            </div>

        </div>
    </div>

    <!-- DRAWER FRÅN HÖGER -->
    <div class="@(collapseNavMenu ? "opacity-0 invisible pointer-events-none translate-x-full" : "opacity-100 visible pointer-events-auto translate-x-0") transition-all duration-300 ease-in-out md:hidden absolute w-[260px] right-0 top-[100%] h-auto z-50 overflow-visible pb-8">

        <div class="absolute inset-0 z-0 overflow-visible pointer-events-none w-[calc(100%+30px)]">
            <svg viewBox="0 0 260 300" preserveAspectRatio="none" class="w-full h-full overflow-visible">
                <defs>
                    <filter id="rugged-drawer-unique" x="-30%" y="-30%" width="160%" height="160%">
                        <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="4" result="noise" />
                        <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
                    </filter>
                    <linearGradient id="mobile-nav-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#FF8400" />
                        <stop offset="100%" stop-color="#e67500" />
                    </linearGradient>
                </defs>

                <path d="M 400,0 L 400,350 L 260,300 L 210,296 L 170,303 L 125,296 L 80,303 L 40,296 L 12,300 L 10,275 L 14,250 L 9,225 L 15,200 L 10,175 L 14,150 L 9,125 L 15,100 L 10,75 L 14,50 L 9,25 L 12,0 Z"
                      fill="url(#mobile-nav-grad)" filter="url(#rugged-drawer-unique)" />

                <path d="M 12,0 L 9,25 L 14,50 L 10,75 L 15,100 L 9,125 L 14,150 L 10,175 L 15,200 L 9,225 L 14,250 L 10,275 L 12,300"
                      fill="none" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-drawer-unique)" />

                <path d="M 12,300 L 40,296 L 80,303 L 125,296 L 170,303 L 210,296 L 260,300"
                      fill="none" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-drawer-unique)" />
            </svg>
        </div>

        <!-- ... (Översta delen av filen förblir oförändrad) ... -->

        <ul class="relative z-10 flex flex-col w-full pl-4 pr-4 pt-4 space-y-4">
            <li class="flex flex-col w-full">
                <div class="flex items-center justify-between w-full pl-2 pr-2">
                    <div class="text-[1.1rem]"><NavItem Href="menu" OnClick="CloseNavMenu">Meny</NavItem></div>
                    <!-- Alla containrar är identiska 12x12 -->
                    <div class="w-12 h-12 flex items-center justify-center shrink-0">
                        <!-- Alla ikoner har samma klasser, vi ändrar bara 'scale' för att de ska se lika stora ut -->
                        <img src="assets/burrito.png" alt="Burrito" class="w-10 h-10 object-contain filter drop-shadow-md opacity-90" />
                    </div>
                </div>
                <div class="w-[85%] mx-auto h-3 overflow-visible pointer-events-none mt-1 opacity-40">
                    <svg viewBox="0 0 300 20" preserveAspectRatio="none" class="w-full h-full"><path d="M0,10 L15,4 L30,16 L45,4 L60,16 L75,4 L90,16 L105,4 L120,16 L135,4 L150,16 L165,4 L180,16 L195,4 L210,16 L225,4 L240,16 L255,4 L270,16 L285,4 L300,10" stroke="white" stroke-width="3" fill="none" /></svg>
                </div>
            </li>

            <li class="flex flex-col w-full">
                <div class="flex items-center justify-between w-full pl-2 pr-2">
                    <div class="text-[1.1rem]"><NavItem Href="platser" OnClick="CloseNavMenu">Platser</NavItem></div>
                    <div class="w-12 h-12 flex items-center justify-center shrink-0">
                        <img src="assets/lime.png" alt="Lime" class="w-10 h-10 object-contain filter drop-shadow-md opacity-90" />
                    </div>
                </div>
                <div class="w-[85%] mx-auto h-3 overflow-visible pointer-events-none mt-1 opacity-40"><svg viewBox="0 0 300 20" preserveAspectRatio="none" class="w-full h-full"><path d="M0,10 L15,4 L30,16 L45,4 L60,16 L75,4 L90,16 L105,4 L120,16 L135,4 L150,16 L165,4 L180,16 L195,4 L210,16 L225,4 L240,16 L255,4 L270,16 L285,4 L300,10" stroke="white" stroke-width="3" fill="none" /></svg></div>
            </li>

            <li class="flex flex-col w-full">
                <div class="flex items-center justify-between w-full pl-2 pr-2">
                    <div class="text-[1.1rem]"><NavItem Href="kontakt" OnClick="CloseNavMenu">Kontakt</NavItem></div>
                    <div class="w-12 h-12 flex items-center justify-center shrink-0">
                        <!-- Sombrero får scale-150 för att fylla ut containern optiskt lika stort som de andra -->
                        <img src="assets/sombrero.png" alt="Sombrero" class="w-10 h-10 object-contain filter drop-shadow-md opacity-90 scale-150" />
                    </div>
                </div>
                <div class="w-[85%] mx-auto h-3 overflow-visible pointer-events-none mt-1 opacity-40"><svg viewBox="0 0 300 20" preserveAspectRatio="none" class="w-full h-full"><path d="M0,10 L15,4 L30,16 L45,4 L60,16 L75,4 L90,16 L105,4 L120,16 L135,4 L150,16 L165,4 L180,16 L195,4 L210,16 L225,4 L240,16 L255,4 L270,16 L285,4 L300,10" stroke="white" stroke-width="3" fill="none" /></svg></div>
            </li>

            <li class="flex flex-col w-full">
                <div class="flex items-center justify-between w-full pl-2 pr-2">
                    <div class="text-[1.1rem]"><NavItem Href="om-oss" OnClick="CloseNavMenu">Om Oss</NavItem></div>
                    <div class="w-12 h-12 flex items-center justify-center shrink-0">
                        <img src="assets/chili.png" alt="Chili" class="w-10 h-10 object-contain filter drop-shadow-md opacity-90" />
                    </div>
                </div>
            </li>
        </ul>
    </div>
    <!-- ... (Resten av filen) ... -->
    <!-- DIN ORIGINAL-BORDER FÖR NAVBAREN -->
    <div class="absolute bottom-0 left-0 w-full translate-y-[100%] -mt-1 pointer-events-none z-10 overflow-visible h-8 select-none">
        <svg viewBox="0 0 1000 40" preserveAspectRatio="none" class="w-full h-full overflow-visible">
            <defs>
                <filter id="rugged-top-local">
                    <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="4" result="noise" />
                    <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
                </filter>
            </defs>
            <path d="M0,-20 V20 L40,11 L80,26 L125,9 L170,24 L215,12 L260,27 L305,10 L350,25 L400,12 L450,28 L500,11 L550,26 L600,13 L650,27 L700,10 L750,25 L800,12 L850,28 L900,11 L950,26 L1000,16 V-20 Z" fill="#FF8400" filter="url(#rugged-top-local)" />
            <path d="M0,20 L40,11 L80,26 L125,9 L170,24 L215,12 L260,27 L305,10 L350,25 L400,12 L450,28 L500,11 L550,26 L600,13 L650,27 L700,10 L750,25 L800,12 L850,28 L900,11 L950,26 L1000,16" stroke="white" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-top-local)" />
        </svg>
    </div>
</nav>