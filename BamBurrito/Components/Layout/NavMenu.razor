@rendermode InteractiveServer

<nav class="bg-[#FF8400] shadow-[0_4px_15px_-3px_rgba(0,0,0,0.5)] w-full z-50 top-0 sticky relative h-24">
    <div class="w-full max-w-[1600px] px-4 sm:px-8 lg:px-12 mx-auto h-full relative z-20">
        <div class="flex justify-between items-center h-full relative">

            <div class="flex-shrink-0 flex items-center pl-2 md:pl-4">
                <a href="" class="flex items-center gap-2 transform transition hover:scale-105 duration-300">
                    <img src="assets/Logo.png" alt="BamBurrito Logo" class="h-16 md:h-20 w-auto filter drop-shadow-md" />
                </a>
            </div>

            <div class="hidden md:flex flex-grow justify-center items-center space-x-2">
                <NavItem Href="meny">Meny</NavItem>
                <img src="assets/burrito.png" alt="Burrito icon" class="nav-burrito-icon h-10 w-10 object-contain filter drop-shadow-md opacity-80" />

                <NavItem Href="platser">Platser</NavItem>
                <img src="assets/lime.png" alt="Lime icon" class="nav-burrito-icon h-20 w-20 object-contain filter drop-shadow-md opacity-80" />

                <NavItem Href="kontakt">Kontakt</NavItem>
                <img src="assets/sombrero.png" alt="Sombrero icon" class="nav-burrito-icon h-20 w-24 object-contain filter drop-shadow-md opacity-80" />

                <NavItem Href="om-oss">Om Oss</NavItem>
                <img src="assets/chili.png" alt="Chili icon" class="nav-burrito-icon h-16 w-16 object-contain filter drop-shadow-md opacity-80" />
            </div>

            <div class="hidden md:flex absolute right-0 flex-col items-center justify-center space-y-2 h-full z-20">
                <a href="https://www.facebook.com/profile.php?id=61588663281337" target="_blank"
                   class="text-white hover:scale-110 transform transition-all duration-300 ease-in-out filter drop-shadow-sm">
                    <span class="sr-only">Facebook</span>
                    <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
                    </svg>
                </a>

                <a href="http://instagram.se/elbamburrito" target="_blank"
                   class="text-white hover:scale-110 transform transition-all duration-300 ease-in-out filter drop-shadow-sm">
                    <span class="sr-only">Instagram</span>
                    <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                </a>
            </div>

            <div class="absolute right-0 flex items-center md:hidden z-30">
                <button type="button" @onclick="ToggleNavMenu" class="inline-flex items-center justify-center p-3 rounded-md text-white hover:scale-110 transform transition-transform focus:outline-none relative z-50">
                    <span class="sr-only">Öppna meny</span>
                    @if (collapseNavMenu)
                    {
                        <svg class="h-10 w-10 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    }
                    else
                    {
                        <svg class="h-10 w-10 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    }
                </button>
            </div>

        </div>
    </div>

    <div class="@(collapseNavMenu ? "opacity-0 invisible pointer-events-none translate-y-[-10px]" : "opacity-100 visible pointer-events-auto translate-y-0") transition-all duration-300 ease-in-out md:hidden absolute w-full left-0 top-[100%] bg-gradient-to-b from-[#FF8400] to-[#e67500] shadow-xl z-50 overflow-hidden rounded-b-2xl border-b-2 border-x-2 border-white">
        <ul class="flex flex-col w-full px-6 py-6 space-y-3">
            <li class="flex items-center justify-between border-b border-yellow-300/30 pb-2">
                <NavItem Href="meny" OnClick="CloseNavMenu">Meny</NavItem>
                <div class="w-28 h-20 flex items-center justify-center">
                    <img src="assets/burrito.png" alt="Burrito icon" class="h-10 w-10 object-contain filter drop-shadow-md opacity-90" />
                </div>
            </li>
            <li class="flex items-center justify-between border-b border-yellow-300/30 pb-2">
                <NavItem Href="platser" OnClick="CloseNavMenu">Platser</NavItem>
                <div class="w-28 h-20 flex items-center justify-center">
                    <img src="assets/lime.png" alt="Lime icon" class="h-20 w-20 object-contain filter drop-shadow-md opacity-90" />
                </div>
            </li>
            <li class="flex items-center justify-between border-b border-yellow-300/30 pb-2">
                <NavItem Href="kontakt" OnClick="CloseNavMenu">Kontakt</NavItem>
                <div class="w-28 h-20 flex items-center justify-center">
                    <img src="assets/sombrero.png" alt="Sombrero icon" class="h-20 w-24 object-contain filter drop-shadow-md opacity-90" />
                </div>
            </li>
            <li class="flex items-center justify-between pb-2">
                <NavItem Href="om-oss" OnClick="CloseNavMenu">Om Oss</NavItem>
                <div class="w-28 h-20 flex items-center justify-center">
                    <img src="assets/chili.png" alt="Chili icon" class="h-16 w-16 object-contain filter drop-shadow-md opacity-90" />
                </div>
            </li>
        </ul>
    </div>

    <div class="absolute bottom-0 left-0 w-full translate-y-[100%] -mt-1 pointer-events-none z-10 overflow-visible h-8 select-none">
        <svg viewBox="0 0 1000 40" preserveAspectRatio="none" class="w-full h-full overflow-visible">
            <defs>
                <filter id="rugged-top">
                    <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="4" result="noise" />
                    <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
                </filter>
            </defs>
            <path d="M0,-20 V20 L40,11 L80,26 L125,9 L170,24 L215,12 L260,27 L305,10 L350,25 L400,12 L450,28 L500,11 L550,26 L600,13 L650,27 L700,10 L750,25 L800,12 L850,28 L900,11 L950,26 L1000,16 V-20 Z" fill="#FF8400" filter="url(#rugged-top)" />
            <path d="M0,20 L40,11 L80,26 L125,9 L170,24 L215,12 L260,27 L305,10 L350,25 L400,12 L450,28 L500,11 L550,26 L600,13 L650,27 L700,10 L750,25 L800,12 L850,28 L900,11 L950,26 L1000,16" stroke="white" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#rugged-top)" />
        </svg>
    </div>
</nav>